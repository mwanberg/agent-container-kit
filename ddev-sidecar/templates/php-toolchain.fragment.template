#  && chown root:root /etc/agent-container-kit/fjs-browser /etc/agent-container-kit/fjs-driver \
#  && chmod 0444 /etc/agent-container-kit/fjs-browser /etc/agent-container-kit/fjs-driver
#
## Tests reach the site through SIMPLETEST_BASE_URL, which phpunit.xml usually
## points at the web container. Exporting the loopback address is not enough: a
## project whose autoloader loads environment files overwrites the variable in
## every process that loads it. This bootstrap file sets it after core's test
## bootstrap has required the autoloader, the only order that wins. --bootstrap
## replaces phpunit.xml's own bootstrap, so the file requires core's itself.
