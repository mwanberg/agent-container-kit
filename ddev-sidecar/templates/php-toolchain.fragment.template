# ---------------------------------------------------------------------------
# Per-project build fragment for the sidecar: a PHP and Node baseline matched
# to the project, then OPTIONAL blocks for Drupal tests, rendered-page testing,
# further accessibility checks, and linting. The installer writes
# .ddev/claude.local/Dockerfile.fragment from this template, filling in the
# ARG lines after this header; by hand, copy it there and fill them in. The
# baseline builds on its own.
#
# The OPTIONAL blocks are commented out. To enable one, remove one leading `#`
# (and the space after it) from each line, starting at its `## Needs:` line and
# stopping before the next divider line of dashes, as an editor's
# toggle-comment does. Its notes carry two hashes, so they stay comments, and
# its instructions one, so they come live. Each block says what it needs from
# the blocks before it.
#
# Per-project values, each set once on its ARG line after this header and
# used by name everywhere below, so a change is one line:
#
#     PHP_VERSION         the web container's PHP major.minor, for example 8.3
#     NODE_MAJOR          the Node major the theme's build expects, for example 22:
#                         the theme's .nvmrc if it pins one, else the major of
#                         nodejs_version in .ddev/config.yaml. The rendered-site
#                         block, and the accessibility block built on it, need
#                         20 or newer; their build stops on an older one.
#
# The lint block alone keeps a text placeholder, CORE-LINT-PACKAGES, derived as
# that block shows, because its value is a quoted list.
#
# Each value is checked before it is used. Every check that stops the build
# prints a fix-it block through /usr/local/lib/agent-container-kit/fix-it.sh,
# and the repository keys are checked by key-check.sh beside it;
# Dockerfile.base copies both in before splicing this fragment.
#
# PHP VERSION
#
# PHP_VERSION is the web container's PHP version, major and minor: the value of
# php_version in .ddev/config.yaml. The add-on's `php` extra installs one fixed version instead, so
# it stays off `extras` in .ddev/claude.yaml: both together put two PHP
# versions in one image, with `update-alternatives` selecting which one runs.
#
# The sidecar and the web container share one bind mount, so they share
# `vendor/`. Composer's autoloader includes
# `vendor/composer/platform_check.php`, which stops any PHP process whose
# version does not meet the installed packages' requirements, so drush and
# phpunit fail in a sidecar running such a version. A version that passes the
# check but differs from the web container's runs the code differently from
# the site.
#
# The Sury repository publishes end-of-life PHP versions alongside current
# ones, so an older version installs the same way. An end-of-life PHP here is
# unpatched; it serves no traffic, accepts no inbound connections, and runs
# behind the egress firewall, to run drush and tests against a local database.
#
# The Sury signing key is pinned by fingerprint. key-check.sh rejects the
# downloaded keyring unless the pinned key is its only primary key, because apt
# accepts every key in a signed-by keyring; the pinned key's own subkeys pass.
# After a legitimate rotation, print the new key with:
#
#     curl -fsSL https://packages.sury.org/php/apt.gpg | gpg --show-keys
# ---------------------------------------------------------------------------
USER root

# The per-project values; the header says how to choose them.
ARG PHP_VERSION=PHPVER
ARG NODE_MAJOR=NODEMAJOR

# Both checked by shape before apt or the NodeSource URL uses them.
RUN case "${PHP_VERSION}" in \
      [0-9].[0-9]|[0-9].[0-9][0-9]) ;; \
      *) /usr/local/lib/agent-container-kit/fix-it.sh build-fragment-placeholder name="PHP_VERSION" value="${PHP_VERSION}" form="a PHP major.minor such as 8.3" where="on its ARG line after the header" >&2; exit 1 ;; \
    esac \
 && case "${NODE_MAJOR}" in \
      ""|*[!0-9]*) /usr/local/lib/agent-container-kit/fix-it.sh build-fragment-placeholder name="NODE_MAJOR" value="${NODE_MAJOR}" form="a Node major version such as 22" where="on its ARG line after the header" >&2; exit 1 ;; \
    esac

# The Sury suite is the base image's Debian codename, read from /etc/os-release
# so the PHP packages match the release the image runs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gnupg \
      libzip-dev \
      libicu-dev \
      libxml2-dev \
      libpng-dev \
      libjpeg-dev \
      libfreetype6-dev \
      libonig-dev \
      libxslt-dev \
 && key_url=https://packages.sury.org/php/apt.gpg \
 && if ! curl -fsSL "${key_url}" -o /tmp/sury-php.gpg || [ ! -s /tmp/sury-php.gpg ]; then \
      /usr/local/lib/agent-container-kit/fix-it.sh build-repository-key-download-failed url="${key_url}" packages="PHP" >&2; exit 1; \
    fi \
 && /usr/local/lib/agent-container-kit/key-check.sh /tmp/sury-php.gpg '15058500A0235D97F5D10063B188E2B695BD4743' build-sury-key-mismatch \
 && mkdir -p /etc/apt/keyrings \
 && mv /tmp/sury-php.gpg /etc/apt/keyrings/sury-php.gpg \
 && . /etc/os-release \
 && echo "deb [signed-by=/etc/apt/keyrings/sury-php.gpg] https://packages.sury.org/php/ ${VERSION_CODENAME} main" \
      > /etc/apt/sources.list.d/sury-php.list \
 && apt-get update && apt-get install -y --no-install-recommends \
      php${PHP_VERSION}-cli \
      php${PHP_VERSION}-bcmath \
      php${PHP_VERSION}-curl \
      php${PHP_VERSION}-gd \
      php${PHP_VERSION}-intl \
      php${PHP_VERSION}-mbstring \
      php${PHP_VERSION}-mysql \
      php${PHP_VERSION}-soap \
      php${PHP_VERSION}-xml \
      php${PHP_VERSION}-xsl \
      php${PHP_VERSION}-zip \
      default-mysql-client \
 && update-alternatives --set php "/usr/bin/php${PHP_VERSION}" \
 && apt-get purge -y --auto-remove \
      libzip-dev libicu-dev libxml2-dev libpng-dev libjpeg-dev \
      libfreetype6-dev libonig-dev libxslt-dev gnupg \
 && rm -rf /var/lib/apt/lists/*

# Composer, for its read-only subcommands (show, why, validate), which work
# from the lock file; the managed policy denies the ones that change
# dependencies.
#
# Pinned by digest, because the composer:2 tag moves with every release. The
# digest is the tag's multi-platform index, here Composer 2.10.3.
COPY --from=composer:2@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac /usr/bin/composer /usr/local/bin/composer

# The extension list above is Drupal core's baseline; tune it to the site. Add
# php${PHP_VERSION}-pgsql for a Postgres site, and the extension any configured cache
# backend loads: without it every Drupal bootstrap fails, drush included.
# default-mysql-client provides the `mysql` binary that `drush sql:query` and
# `drush sql:cli` shell out to. mysqldump stays denied by the managed policy.

# Node, for the theme's build scripts and for the optional blocks below. It is
# the runtime only: npm installs stay host-run, since the managed policy denies
# them and the registry is outside the egress allowlist.
#
# NodeSource's apt repository, its signing key checked the way the Sury key is
# above and used for this repository only. The apt preference makes apt install
# NodeSource's nodejs even when Debian's has a higher version; Debian's comes
# without npm. The check after the install stops the build when the image does
# not have the chosen Node major version and npm.
# The pinned fingerprint is that of the key deb.nodesource.com serves, and of
# the key keyserver.ubuntu.com holds under nsolid-gpg@nodesource.com. After a
# legitimate rotation, print the new key with:
#
#     curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --show-keys
RUN apt-get update \
 && apt-get install -y --no-install-recommends gnupg \
 && key_url=https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
 && if ! curl -fsSL "${key_url}" -o /tmp/nodesource.asc || [ ! -s /tmp/nodesource.asc ]; then \
      /usr/local/lib/agent-container-kit/fix-it.sh build-repository-key-download-failed url="${key_url}" packages="Node" >&2; exit 1; \
    fi \
 && /usr/local/lib/agent-container-kit/key-check.sh /tmp/nodesource.asc '6F71F525282841EEDAF851B42F59B5F99B1BE0B4' build-nodesource-key-mismatch \
 && mkdir -p /etc/apt/keyrings \
 && gpg --dearmor < /tmp/nodesource.asc > /etc/apt/keyrings/nodesource.gpg \
 && rm /tmp/nodesource.asc \
 && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
      > /etc/apt/sources.list.d/nodesource.list \
 && printf 'Package: nodejs\nPin: origin deb.nodesource.com\nPin-Priority: 600\n' > /etc/apt/preferences.d/nodesource \
 && apt-get update && apt-get install -y --no-install-recommends nodejs \
 && apt-get purge -y --auto-remove gnupg \
 && rm -rf /var/lib/apt/lists/* \
 && found="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo none)" \
 && if command -v npm >/dev/null 2>&1; then npm=present; else npm=missing; fi \
 && if [ "${found}" != "${NODE_MAJOR}" ] || [ "${npm}" = missing ]; then \
      /usr/local/lib/agent-container-kit/fix-it.sh build-node-not-installed wanted="${NODE_MAJOR}" found="${found}" npm="${npm}" >&2; exit 1; \
    fi

