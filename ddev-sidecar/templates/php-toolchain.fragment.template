# RUN case "CORE-LINT-PACKAGES" in \
#       *@*) ;; \
#       *) /usr/local/lib/agent-container-kit/fix-it.sh build-fragment-placeholder name="CORE-LINT""-PACKAGES" value="CORE-LINT-PACKAGES" form="the package list the lint block's command prints" where="in the lint block, in its check and its npm install line" >&2; exit 1 ;; \
#     esac \
#  && mkdir -p /opt/lint-tools \
#  && cd /opt/lint-tools \
#  && npm init -y >/dev/null 2>&1 \
#  && npm install --no-fund --no-audit CORE-LINT-PACKAGES \
#  && for b in eslint prettier stylelint cspell; do \
#       [ -x "/opt/lint-tools/node_modules/.bin/$b" ] \
#         || { /usr/local/lib/agent-container-kit/fix-it.sh build-lint-package-missing tool="$b" >&2; exit 1; }; \
#       ln -sf "/opt/lint-tools/node_modules/.bin/$b" "/usr/local/bin/$b"; \
#     done \
#  && chmod -R a+rX /opt/lint-tools
#
## twig-cs-fixer, in its own composer project so the project's composer.json
## stays untouched. This install is verified by
## HTTPS and Composer, not by a pinned checksum. It installs the release current
## when this layer is built, and Docker's build cache keeps that release until
## the cache is skipped (`ddev restart --no-cache`).
# RUN mkdir -p /opt/php-tools \
#  && cd /opt/php-tools \
#  && COMPOSER_ALLOW_SUPERUSER=1 composer require --no-interaction --no-progress \
#       vincentlanglet/twig-cs-fixer \
#  && ln -sf /opt/php-tools/vendor/bin/twig-cs-fixer /usr/local/bin/twig-cs-fixer \
#  && chmod -R a+rX /opt/php-tools
