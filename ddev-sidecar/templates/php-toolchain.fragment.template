#   '$_ENV["SIMPLETEST_BASE_URL"] = $loopback;' \
#   '$_SERVER["SIMPLETEST_BASE_URL"] = $loopback;' \
#   > /usr/local/lib/agent-container-kit/loopback-bootstrap.php \
#  && chown root:root /usr/local/lib/agent-container-kit/loopback-bootstrap.php \
#  && chmod 0444 /usr/local/lib/agent-container-kit/loopback-bootstrap.php \
#  && php -l /usr/local/lib/agent-container-kit/loopback-bootstrap.php
#
## The MINK_* variables are exported rather than written into phpunit.xml, a
## tracked file: PHPUnit's <env> elements do not overwrite an already-set
